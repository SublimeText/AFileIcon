[
	{
		"id": "preferences",
		"children": [
			{ "caption": "-" },
			{
				"caption": "Select Icon Theme…",
				"command": "afi_select_file_icon_theme"
			},
			{
				"caption": "Customize Icon Theme",
				"command": "afi_customize_file_icon_theme"
			},
			{ "caption": "-" },
			{
				"id": "package-settings",
				"caption": "Package Settings",
				"children": [
					{
						"caption": "A File Icon",
						"children": [
							{
								"caption": "Settings",
								"command": "edit_settings",
								"args": {
									"base_file": "${packages}/A File Icon/A File Icon.sublime-settings",
									"default": "// A File Icon Preferences – User\n// ================================================================\n{\n\t$0\n}\n"
								}
							}
						]
					}
				]
			}
		]
	}
]
